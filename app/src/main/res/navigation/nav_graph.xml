<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.vamshigollapelly.sportsfeedapp.fragments.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_detail"
            app:destination="@id/detailFragment"/>
    </fragment>

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.vamshigollapelly.sportsfeedapp.fragments.DetailFragment"
        android:label="Detail">
        <argument
            android:name="newsId"
            app:argType="integer"
            android:defaultValue="0"/>
    </fragment>

    <fragment
        android:id="@+id/bookmarkFragment"
        android:name="com.vamshigollapelly.sportsfeedapp.fragments.BookmarkFragment"
        android:label="Bookmarks"/>

</navigation>